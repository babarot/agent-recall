# config file for the tagpr in git config format
# vim: ft=ini
[tagpr]
	releaseBranch = main
	vPrefix = false
	versionFile = src/version.ts,plugin/.claude-plugin/plugin.json
	changelog = true
	majorLabels = release/major,kind/breaking-change
	minorLabels = release/minor,kind/feature,kind/deprecation
